OPENAI_API_KEY=your_openai_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Prisma CLI commands launched from the monorepo root load .env, not .env.local.
# Next.js commands launched from apps/app load apps/app/.env.local.
# Vercel uses environment-scoped project settings instead of these ignored local files.
# For Supabase on IPv4 networks, use transaction mode for runtime traffic and
# session mode for Prisma CLI/migrations. Copy both exact URLs from Supabase Connect.
DATABASE_URL=postgresql://postgres.project_ref:url_encoded_password@region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.project_ref:url_encoded_password@region.pooler.supabase.com:5432/postgres
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your_random_secret_here
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
DISABLE_USAGE_LIMITS=false
ADMIN_USER_IDS=comma_separated_nextauth_token_sub_ids

# Opt-in stage routing. Keep false until benchmark and blinded human acceptance.
AI_MODEL_ROUTING_ENABLED=false
AI_MODEL_FAST=gpt-4o-mini-2024-07-18
AI_MODEL_BALANCED=gpt-4.1-2025-04-14
AI_MODEL_REASONING=o3-2025-04-16
AI_REASONING_DEFAULT=MEDIUM
AI_REASONING_VERIFIER=MEDIUM
AI_REASONING_RECOVERY=HIGH
# Exact-model compatibility overrides, if using models outside the reviewed registry.
AI_MODEL_CAPABILITIES_JSON={}
# USD/token price estimates can be overridden without code changes.
AI_MODEL_PRICING_JSON={}
